    "baseline",
    "--param-dtype",
    "fp32",
    "--train-batch",
    "2"
   ],
   "then": [
    {
     "name": "LH1",
     "live": "LH1",
     "args": [
      "--problems",
      "eval_frontier_512.json",
      "--max-new",
      "1024",
      "--expect-steps",
      "50,100,150,300,500,700,1000",
